<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:controls="clr-namespace:SSSKL.Mobile.Controls"
             xmlns:vm="clr-namespace:SSSKL.Mobile.Core.ViewModels;assembly=SSSKL.Mobile.Core"
             xmlns:loc="clr-namespace:SSSKL.Mobile.Core.Localization;assembly=SSSKL.Mobile.Core"
             xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
             x:Class="SSSKL.Mobile.Views.ProfilePage"
             ios:Page.LargeTitleDisplay="Always"
             x:DataType="vm:ProfileViewModel"
             Title="{x:Static loc:Texts.TabProfile}">
    <ContentPage.Resources>
        <toolkit:IsNotNullConverter x:Key="NotNull" />
        <toolkit:InvertedBoolConverter x:Key="Not" />
    </ContentPage.Resources>

    <Grid>
    <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding LoadCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="16">
                <!-- Header: tap the avatar to change or remove the photo -->
                <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                    <controls:Pressable Command="{Binding PictureActionsCommand}" HorizontalOptions="Center"
                                        SemanticProperties.Description="{x:Static loc:Texts.ChangeProfilePicture}">
                        <Grid WidthRequest="112" HeightRequest="112">
                            <Border Style="{StaticResource AvatarLarge}">
                                <Label Text="{Binding Initials}" FontSize="36" FontAttributes="Bold" FontAutoScalingEnabled="False"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Border Style="{StaticResource AvatarLarge}" IsVisible="{Binding HasPicture}">
                                <controls:FadeImage Source="{Binding PictureUrl}" Aspect="AspectFill" />
                            </Border>
                            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
                            <!-- Edit badge -->
                            <Border WidthRequest="32" HeightRequest="32" StrokeShape="RoundRectangle 16" StrokeThickness="2"
                                    Stroke="{AppThemeBinding Light={StaticResource PageLight}, Dark={StaticResource PageDark}}"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource Primary700}, Dark={StaticResource Primary400}}"
                                    HorizontalOptions="End" VerticalOptions="End">
                                <controls:IconView Icon="{x:Static loc:Icons.Pencil}" Size="16"
                                                   Color="{AppThemeBinding Light=White, Dark={StaticResource PageDark}}" />
                            </Border>
                        </Grid>
                    </controls:Pressable>
                    <Label Text="{Binding DisplayName}" Style="{StaticResource Headline}" HorizontalTextAlignment="Center"
                           SemanticProperties.HeadingLevel="Level1" />
                    <Label Text="{Binding UserName}" Style="{StaticResource Muted}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <!-- Saldo + stats: one card, three columns with dividers -->
                <Border Style="{StaticResource Card}" Padding="0">
                    <Grid ColumnDefinitions="*,1,*,1,*" Padding="0,14">
                        <VerticalStackLayout Spacing="2" Padding="8,0">
                            <Label Text="{Binding Saldo}" Style="{StaticResource Stat}" HorizontalTextAlignment="Center"
                                   LineBreakMode="NoWrap" MaxLines="1">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsSaldoNegative}" Value="True">
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <Label Text="{x:Static loc:Texts.MySaldo}" Style="{StaticResource Muted}" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                        <BoxView Grid.Column="1" Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
                        <VerticalStackLayout Grid.Column="2" Spacing="2" Padding="8,0">
                            <Label Text="{Binding TotalOrders}" Style="{StaticResource Stat}" HorizontalTextAlignment="Center" MaxLines="1" />
                            <Label Text="{x:Static loc:Texts.TotalOrders}" Style="{StaticResource Muted}" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                        <BoxView Grid.Column="3" Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
                        <VerticalStackLayout Grid.Column="4" Spacing="2" Padding="8,0">
                            <Label Text="{Binding CurrentStreak}" Style="{StaticResource Stat}" HorizontalTextAlignment="Center" MaxLines="1" />
                            <Label Text="{x:Static loc:Texts.CurrentStreak}" Style="{StaticResource Muted}" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- About me: shown as HTML, edited as plain text -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="{x:Static loc:Texts.AboutMe}" FontAttributes="Bold" FontSize="{StaticResource FontSizeCallout}" VerticalOptions="Center"
                                   SemanticProperties.HeadingLevel="Level2" />
                            <Button Grid.Column="1" Text="{x:Static loc:Texts.Edit}" Command="{Binding EditDescriptionCommand}"
                                    IsVisible="{Binding IsEditingDescription, Converter={StaticResource Not}}"
                                    Style="{StaticResource SecondaryButton}" />
                        </Grid>

                        <VerticalStackLayout IsVisible="{Binding IsEditingDescription, Converter={StaticResource Not}}">
                            <Label Text="{Binding DescriptionHtml}" TextType="Html"
                                   IsVisible="{Binding DescriptionHtml, Converter={StaticResource NotNull}}" />
                            <Label Text="{x:Static loc:Texts.NoDescription}" Style="{StaticResource Muted}"
                                   IsVisible="{Binding HasNoDescription}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="10" IsVisible="{Binding IsEditingDescription}">
                            <Border Style="{StaticResource FieldBox}" Padding="8,4">
                                <Editor Text="{Binding DescriptionDraft}" Placeholder="{x:Static loc:Texts.DescriptionPlaceholder}"
                                        AutoSize="TextChanges" MinimumHeightRequest="120" FontSize="{StaticResource FontSizeCallout}" Keyboard="Chat"
                                        BackgroundColor="Transparent"
                                        TextColor="{AppThemeBinding Light={StaticResource HeadingLight}, Dark={StaticResource HeadingDark}}"
                                        PlaceholderColor="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}"
                                        SemanticProperties.Description="{x:Static loc:Texts.AboutMe}" />
                            </Border>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <Button Text="{x:Static loc:Texts.Cancel}" Command="{Binding CancelEditDescriptionCommand}"
                                        Style="{StaticResource SecondaryButton}" />
                                <Grid Grid.Column="1">
                                    <Button Text="{x:Static loc:Texts.Save}" Command="{Binding SaveDescriptionCommand}" />
                                    <ActivityIndicator IsRunning="{Binding IsSavingDescription}" IsVisible="{Binding IsSavingDescription}"
                                                       Color="White" HeightRequest="20" WidthRequest="20"
                                                       HorizontalOptions="End" Margin="0,0,12,0" />
                                </Grid>
                            </Grid>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Achievements -->
                <Label Text="{x:Static loc:Texts.Achievements}" Style="{StaticResource SectionHeader}" SemanticProperties.HeadingLevel="Level2" />
                <Label Text="{x:Static loc:Texts.NoAchievements}" IsVisible="{Binding HasNoAchievements}" Style="{StaticResource Muted}" />
                <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding Achievements}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:AchievementItem">
                            <controls:Pressable FlexLayout.Basis="33.3%" SemanticProperties.Description="{Binding Name}"
                                                Command="{Binding OpenAchievementCommand, Source={RelativeSource AncestorType={x:Type vm:ProfileViewModel}}, x:DataType=vm:ProfileViewModel}"
                                                CommandParameter="{Binding .}">
                                <!-- Same tile as on other members' profiles (UserProfilePage) -->
                                <VerticalStackLayout Padding="4" Spacing="4">
                                    <Border WidthRequest="72" HeightRequest="72" StrokeThickness="0" StrokeShape="RoundRectangle 16"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource SunkenLight}, Dark={StaticResource SunkenDark}}">
                                        <Grid>
                                            <Image Source="{Binding ImageUrl}" Aspect="AspectFit" Margin="8" IsVisible="{Binding HasImage}" />
                                            <controls:IconView Icon="{x:Static loc:Icons.Rosette}" Size="32"
                                                               IsVisible="{Binding HasImage, Converter={StaticResource Not}}"
                                                               Color="{AppThemeBinding Light={StaticResource Primary500}, Dark={StaticResource Primary400}}" />
                                        </Grid>
                                    </Border>
                                    <Label Text="{Binding Name}" FontSize="{StaticResource FontSizeCaption}" HorizontalTextAlignment="Center"
                                           LineBreakMode="TailTruncation" MaxLines="2" />
                                </VerticalStackLayout>
                            </controls:Pressable>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>

                <!-- Your orders, statistics and achievements, and the settings -->
                <Border Style="{StaticResource Group}">
                    <VerticalStackLayout>
                        <controls:MenuRow IsFirst="True" Icon="{x:Static loc:Icons.Rosette}" Title="{x:Static loc:Texts.Achievements}"
                                          Command="{Binding OpenCommand}" CommandParameter="achievements" />
                        <controls:MenuRow Icon="{x:Static loc:Icons.History}" Title="{x:Static loc:Texts.MyOrders}"
                                          Command="{Binding OpenCommand}" CommandParameter="orders/personal" />
                        <controls:MenuRow Icon="{x:Static loc:Icons.ChartLine}" Title="{x:Static loc:Texts.Stats}"
                                          Command="{Binding OpenCommand}" CommandParameter="stats" />
                        <controls:MenuRow Icon="{x:Static loc:Icons.Settings}" Title="{x:Static loc:Texts.Settings}"
                                          Command="{Binding OpenSettingsCommand}" />
                    </VerticalStackLayout>
                </Border>
                <Border Style="{StaticResource Group}">
                    <controls:MenuRow IsFirst="True" Icon="{x:Static loc:Icons.Logout}" Title="{x:Static loc:Texts.Logout}"
                                      IsDestructive="True" ShowChevron="False" Command="{Binding LogoutCommand}" />
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
        <!-- First load: placeholders in the page's shape; a failed first load: error with retry -->
        <controls:SkeletonView Kind="Profile" IsVisible="{Binding ShowSkeleton}" />
        <controls:ErrorStateView IsVisible="{Binding HasLoadError}" RetryCommand="{Binding LoadCommand}" />
    </Grid>
</ContentPage>
