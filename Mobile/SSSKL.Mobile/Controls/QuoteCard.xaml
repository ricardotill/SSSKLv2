<?xml version="1.0" encoding="utf-8" ?>
<!-- A quote: big quotation mark, the text in italics, who said it, the date, votes (❤️) and comments.
     BindingContext is a QuoteRow; OpenCommand and VoteCommand get the row. The two tap targets don't nest:
     the text part opens the quote, the footer's heart votes. -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:SSSKL.Mobile.Controls"
             xmlns:vm="clr-namespace:SSSKL.Mobile.Core.ViewModels;assembly=SSSKL.Mobile.Core"
             xmlns:loc="clr-namespace:SSSKL.Mobile.Core.Localization;assembly=SSSKL.Mobile.Core"
             x:Class="SSSKL.Mobile.Controls.QuoteCard"
             x:DataType="vm:QuoteRow">
    <Border Style="{StaticResource Card}" Padding="18,16">
        <VerticalStackLayout Spacing="12">
            <controls:Pressable x:Name="OpenArea">
                <VerticalStackLayout Spacing="12">
                    <Grid>
                        <Label Text="“" FontSize="64" FontFamily="serif" Margin="-6,-22,0,0" VerticalOptions="Start"
                               AutomationProperties.IsInAccessibleTree="False"
                               TextColor="{AppThemeBinding Light={StaticResource Primary200}, Dark={StaticResource Primary900}}" />
                        <Label x:Name="TextLabel" Text="{Binding Text}" FontSize="18" FontAttributes="Italic" Margin="0,6,0,0"
                               LineBreakMode="TailTruncation"
                               TextColor="{AppThemeBinding Light={StaticResource HeadingLight}, Dark={StaticResource HeadingDark}}" />
                    </Grid>
                    <Label Text="{Binding AuthorsText}" FontAttributes="Bold" FontSize="14"
                           TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
                    <HorizontalStackLayout Spacing="6">
                        <controls:IconView Icon="{x:Static loc:Icons.Calendar}" Size="14"
                                           Color="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
                        <Label Text="{Binding DateText}" Style="{StaticResource Muted}" FontSize="13" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </controls:Pressable>
            <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
            <HorizontalStackLayout Spacing="16">
                <!-- Vote -->
                <controls:Pressable x:Name="VoteButton" SemanticProperties.Description="{x:Static loc:Texts.Vote}">
                    <HorizontalStackLayout Spacing="6" Padding="0,4">
                        <Grid WidthRequest="20" HeightRequest="20">
                            <controls:IconView Icon="{x:Static loc:Icons.Heart}" Size="20" IsVisible="{Binding HasNotVoted}"
                                               Color="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
                            <controls:IconView Icon="{x:Static loc:Icons.HeartFilled}" Size="20" IsVisible="{Binding HasVoted}" Color="#EF4444" />
                        </Grid>
                        <Label Text="{Binding VoteText}" FontAttributes="Bold" FontSize="14" VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
                    </HorizontalStackLayout>
                </controls:Pressable>
                <!-- Comments -->
                <HorizontalStackLayout Spacing="6" Padding="0,4">
                    <controls:IconView Icon="{x:Static loc:Icons.Message}" Size="20"
                                       Color="{AppThemeBinding Light={StaticResource Primary600}, Dark={StaticResource Primary400}}" />
                    <Label Text="{Binding CommentsCount}" FontAttributes="Bold" FontSize="14" VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
                </HorizontalStackLayout>
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </Border>
</ContentView>
