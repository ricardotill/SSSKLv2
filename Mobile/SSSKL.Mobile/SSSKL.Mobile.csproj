<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net11.0-android;net11.0-ios</TargetFrameworks>
    <!-- CI builds one platform per runner: -p:SssklTargetFrameworks=net11.0-android limits restore to it
         (TargetFrameworks itself can't be passed: as a global property it would also retarget Core). -->
    <TargetFrameworks Condition="'$(SssklTargetFrameworks)' != ''">$(SssklTargetFrameworks)</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>SSSKL.Mobile</RootNamespace>
    <!-- DebugProduction: a Debug build (debugger, DEBUG symbol, no Native AOT) against the production
         site and API, for testing on a device against real data. -->
    <Configurations>Debug;Release;DebugProduction</Configurations>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>

    <!-- Release: Native AOT (fully trimmed, no JIT/interpreter fallback). Needs reflection-free code:
         compiled bindings (x:DataType) and source-generated JSON (SSSKL.Mobile.Core ApiJsonContext).
         Treat any IL2xxx/IL3xxx warning from `dotnet publish` as a bug. -->
    <PublishAot Condition="'$(Configuration)' == 'Release'">true</PublishAot>

    <!-- Compiled bindings everywhere (x:DataType), also for bindings with a Source. -->
    <MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>

    <ApplicationTitle>SSSKL</ApplicationTitle>
    <ApplicationId>nl.scoutingwilo.ssskl</ApplicationId>
    <!-- Display version follows the backend/frontend version (Directory.Build.props). -->
    <ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <!-- Sentry: in Release builds, upload debug symbols and sources (file/line + code in stack traces) to
       project ssskl-mobile. Only when SENTRY_AUTH_TOKEN is set (deploy CI secret), so local builds don't upload. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' and '$(SENTRY_AUTH_TOKEN)' != ''">
    <SentryOrg>ricardo-tillemans</SentryOrg>
    <SentryProject>ssskl-mobile</SentryProject>
    <SentryUploadSymbols>true</SentryUploadSymbols>
    <SentryUploadSources>true</SentryUploadSources>
  </PropertyGroup>


  <!-- DebugProduction builds like Debug. The SDK only applies its Debug defaults to a configuration
       named "Debug", so set the essentials here. -->
  <PropertyGroup Condition="'$(Configuration)' == 'DebugProduction'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>portable</DebugType>
    <Optimize>false</Optimize>
    <DefineConstants>$(DefineConstants);DEBUG;TRACE</DefineConstants>
  </PropertyGroup>

  <!-- SPA location; the SPA's origin also serves /api (Static Web Apps linked backend in production,
       the Angular dev-server proxy locally). Override per build: dotnet build -p:SssklWebUrl=... -p:SssklApiUrl=...
       Debug builds without an override use http://10.0.2.2:4300 (Android emulator) or http://localhost:4300 (iOS simulator),
       served by `npm run start:mobile` in Frontend/. -->
  <PropertyGroup>
    <SssklWebUrl Condition="'$(SssklWebUrl)' == '' and ('$(Configuration)' == 'Release' or '$(Configuration)' == 'DebugProduction')">https://ssskl.scoutingwilo.nl</SssklWebUrl>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute" Condition="'$(SssklApiUrl)' != ''">
      <_Parameter1>SssklApiUrl</_Parameter1>
      <_Parameter2>$(SssklApiUrl)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute" Condition="'$(SssklWebUrl)' != ''">
      <_Parameter1>SssklWebUrl</_Parameter1>
      <_Parameter2>$(SssklWebUrl)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#34D399" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#34D399" BaseSize="128,128" />
    <!-- ti_*.svg and tab_*.svg: Tabler Icons (MIT, https://tabler.io/icons); each file carries the license. -->
    <MauiImage Include="Resources\Images\*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Maui" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="Sentry.Maui" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <PackageReference Include="Xamarin.AndroidX.WebKit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SSSKL.Mobile.Core\SSSKL.Mobile.Core.csproj" />
  </ItemGroup>
</Project>
