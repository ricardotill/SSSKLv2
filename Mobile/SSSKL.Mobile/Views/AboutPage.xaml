<?xml version="1.0" encoding="utf-8" ?>
<!-- "Over SSSKL", like the SPA's about page (features/homepage). -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:SSSKL.Mobile.Controls"
             xmlns:loc="clr-namespace:SSSKL.Mobile.Core.Localization;assembly=SSSKL.Mobile.Core"
             x:Class="SSSKL.Mobile.Views.AboutPage"
             Title="{x:Static loc:Texts.About}">
    <ScrollView>
        <VerticalStackLayout Padding="16,24,16,32" Spacing="16">
            <Border Style="{StaticResource Card}" Padding="24,32">
                <VerticalStackLayout Spacing="20">
                    <Border WidthRequest="144" HeightRequest="144" HorizontalOptions="Center" StrokeThickness="0"
                            StrokeShape="RoundRectangle 12"
                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
                        <Border.Shadow>
                            <Shadow Brush="Black" Opacity="0.25" Radius="16" Offset="0,6" />
                        </Border.Shadow>
                        <Image Source="logo.png" Aspect="AspectFill" SemanticProperties.Description="{x:Static loc:Texts.Logo}" />
                    </Border>

                    <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                        <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                            <Label Text="{x:Static loc:Texts.AppName}" Style="{StaticResource Headline}" FontSize="30"
                                   SemanticProperties.HeadingLevel="Level1" VerticalOptions="Center" />
                            <Label x:Name="VersionLabel" Style="{StaticResource Muted}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Label Style="{StaticResource Muted}" FontSize="15" HorizontalTextAlignment="Center"
                               SemanticProperties.Hint="{x:Static loc:Texts.OpenAuthorWebsite}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnAuthorTapped" />
                            </Label.GestureRecognizers>
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{x:Static loc:Texts.MadeWithLoveBy}" />
                                    <Span Text=" " />
                                    <Span Text="{x:Static loc:Texts.Author}" FontAttributes="Bold"
                                          TextColor="{AppThemeBinding Light={StaticResource Primary700}, Dark={StaticResource Primary400}}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </VerticalStackLayout>

                    <controls:Pressable x:Name="GitHubButton" HorizontalOptions="Center"
                                        SemanticProperties.Description="{x:Static loc:Texts.ViewOnGitHub}">
                        <Border StrokeShape="RoundRectangle 20" Padding="16,9" StrokeThickness="1"
                                Stroke="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource SunkenLight}, Dark={StaticResource SunkenDark}}">
                            <HorizontalStackLayout Spacing="8">
                                <controls:IconView Icon="{x:Static loc:Icons.BrandGithub}" Size="18" />
                                <Label Text="{x:Static loc:Texts.ViewOnGitHub}" FontSize="14" VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
                            </HorizontalStackLayout>
                        </Border>
                    </controls:Pressable>

                    <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />

                    <Label Style="{StaticResource Muted}" FontSize="14" LineHeight="1.3">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{x:Static loc:Texts.DeleteAccountInfo}" />
                                <Span Text=" " />
                                <Span Text="{x:Static loc:Texts.ContactEmail}" FontAttributes="Bold"
                                      TextColor="{AppThemeBinding Light={StaticResource Primary700}, Dark={StaticResource Primary400}}">
                                    <Span.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnMailTapped" />
                                    </Span.GestureRecognizers>
                                </Span>
                                <Span Text="." />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
