# Copy to .env and fill in. .env holds secrets: it is never committed. See docs/docker.md.
# Used by docker-compose.yml (full stack) and docker-compose.external.yml (existing database and storage).

# Optional: the app version to run, e.g. 3.13.0 (default latest, the newest release)
#APP_VERSION=
# Optional: the port on this machine (default 8080)
#PORT=8080
# The host name visitors use, e.g. ssskl.example.nl (passkeys only work on this name); default localhost
WEBSITE_DOMAIN=
# Set to true only to try SSSKL on plain http://localhost; behind HTTPS (a tunnel or your proxy) leave it off
#ALLOW_HTTP=false

# --- docker-compose.yml only ---
# Password of the SQL Server `sa` account: at least 8 characters, with upper case, lower case and digits
SQL_SA_PASSWORD=

# --- docker-compose.external.yml only ---
# The SQL Server database. A server on this machine is host.docker.internal, e.g.
# Server=host.docker.internal;Database=ssskl;User Id=ssskl;Password=...;TrustServerCertificate=True
DATABASE_CONNECTION_STRING=
# The blob storage account, e.g. DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
BLOB_CONNECTION_STRING=
#BLOB_CONTAINER_NAME=ssskl
# Optional: Azure SignalR Service (only needed with more than one API instance)
#AZURE_SIGNALR_ENABLED=true
#AZURE_SIGNALR_CONNECTION_STRING=

# --- Optional, both files ---
# Web push notifications (generate a pair with `npx web-push generate-vapid-keys`)
#VAPID_PUBLIC_KEY=
#VAPID_PRIVATE_KEY=
# MediatR Community license; without it MediatR only logs a warning
#MEDIATR_LICENSE_KEY=
# Environment name in Sentry (default production)
#SENTRY_ENVIRONMENT=production
# Token of a Cloudflare Tunnel, for --profile tunnel (see docs/docker.md)
#CLOUDFLARE_TUNNEL_TOKEN=
