<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:SSSKL.Mobile.Controls"
             xmlns:vm="clr-namespace:SSSKL.Mobile.Core.ViewModels;assembly=SSSKL.Mobile.Core"
             xmlns:loc="clr-namespace:SSSKL.Mobile.Core.Localization;assembly=SSSKL.Mobile.Core"
             x:Class="SSSKL.Mobile.Views.QuoteDetailPage"
             x:DataType="vm:QuoteDetailViewModel"
             Title="{x:Static loc:Texts.Quotes}">
    <Grid>
        <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding LoadCommand}">
            <ScrollView>
                <VerticalStackLayout Padding="16,8,16,32" Spacing="16">
                    <Label Text="{x:Static loc:Texts.QuoteNotFound}" IsVisible="{Binding IsNotFound}" Style="{StaticResource Muted}"
                           HorizontalTextAlignment="Center" Margin="16,48" />

                    <VerticalStackLayout Spacing="16" IsVisible="{Binding IsFound}">
                        <controls:QuoteCard BindingContext="{Binding Quote}"
                                            VoteCommand="{Binding VoteCommand, Source={RelativeSource AncestorType={x:Type vm:QuoteDetailViewModel}}, x:DataType=vm:QuoteDetailViewModel}" />

                        <!-- Who said it: members open their profile -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{x:Static loc:Texts.SaidBy}" Style="{StaticResource SectionHeader}" Margin="0" SemanticProperties.HeadingLevel="Level2" />
                            <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding Authors}" Margin="-4,0">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:QuoteAuthorItem">
                                        <controls:Pressable Margin="4" IsEnabled="{Binding IsMember}" SemanticProperties.Description="{Binding Name}"
                                                            Command="{Binding OpenAuthorCommand, Source={RelativeSource AncestorType={x:Type vm:QuoteDetailViewModel}}, x:DataType=vm:QuoteDetailViewModel}"
                                                            CommandParameter="{Binding .}">
                                            <Border Style="{StaticResource Card}" Padding="6,6,14,6" StrokeShape="RoundRectangle 22">
                                                <HorizontalStackLayout Spacing="8">
                                                    <controls:AvatarView Size="30" Initials="{Binding Initials}" PictureUrl="{Binding PictureUrl}" />
                                                    <Label Text="{Binding Name}" FontAttributes="Bold" VerticalOptions="Center"
                                                           TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
                                                </HorizontalStackLayout>
                                            </Border>
                                        </controls:Pressable>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </VerticalStackLayout>

                        <!-- Whoever added it, its authors and admins -->
                        <Border Style="{StaticResource Group}" IsVisible="{Binding CanEdit}">
                            <VerticalStackLayout>
                                <controls:MenuRow IsFirst="True" Icon="{x:Static loc:Icons.Pencil}" Title="{x:Static loc:Texts.Edit}"
                                                  Command="{Binding EditCommand}" />
                                <controls:MenuRow Icon="{x:Static loc:Icons.Trash}" Title="{x:Static loc:Texts.DeleteQuote}"
                                                  IsDestructive="True" ShowChevron="False" Command="{Binding DeleteCommand}" />
                            </VerticalStackLayout>
                        </Border>

                        <controls:CommentsView BindingContext="{Binding Comments}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
        <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" HorizontalOptions="Center" VerticalOptions="Center" />
    </Grid>
</ContentPage>
