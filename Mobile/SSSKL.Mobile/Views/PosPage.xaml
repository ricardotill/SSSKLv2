<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:controls="clr-namespace:SSSKL.Mobile.Controls"
             xmlns:vm="clr-namespace:SSSKL.Mobile.Core.ViewModels;assembly=SSSKL.Mobile.Core"
             xmlns:loc="clr-namespace:SSSKL.Mobile.Core.Localization;assembly=SSSKL.Mobile.Core"
             xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
             x:Class="SSSKL.Mobile.Views.PosPage"
             ios:Page.LargeTitleDisplay="Always"
             x:DataType="vm:PosViewModel"
             Title="{x:Static loc:Texts.TabPos}">
    <ContentPage.Resources>
        <toolkit:InvertedBoolConverter x:Key="Not" />
        <toolkit:IsNotNullConverter x:Key="NotNull" />
    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto">
        <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding LoadCommand}">
            <ScrollView>
                <VerticalStackLayout Padding="16" Spacing="12">
                    <Label Text="{x:Static loc:Texts.GuestCannotOrder}" IsVisible="{Binding IsGuest}" Style="{StaticResource Notice}" />

                    <Label Text="{x:Static loc:Texts.Products}" Style="{StaticResource SectionHeader}" SemanticProperties.HeadingLevel="Level2" />
                    <FlexLayout Wrap="Wrap" JustifyContent="Start" BindableLayout.ItemsSource="{Binding Products}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProductItemViewModel">
                                <controls:Pressable FlexLayout.Basis="50%" SemanticProperties.Description="{Binding Description}"
                                                    Command="{Binding ToggleProductCommand, Source={RelativeSource AncestorType={x:Type vm:PosViewModel}}, x:DataType=vm:PosViewModel}"
                                                    CommandParameter="{Binding .}">
                                    <Grid>
                                    <Border Style="{StaticResource Tile}">
                                        <Border.Triggers>
                                            <!-- The thicker stroke takes its extra pixel out of the padding, so the tile keeps its size -->
                                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Stroke" Value="{StaticResource Primary500}" />
                                                <Setter Property="StrokeThickness" Value="2" />
                                                <Setter Property="Padding" Value="11" />
                                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary50}, Dark={StaticResource Primary950}}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Grid>
                                            <VerticalStackLayout Spacing="1" Margin="0,0,24,0" VerticalOptions="Center">
                                                <Label Text="{Binding Name}" FontAttributes="Bold" MaxLines="2" LineBreakMode="TailTruncation"
                                                       TextColor="{AppThemeBinding Light={StaticResource HeadingLight}, Dark={StaticResource HeadingDark}}" />
                                                <Label Text="{Binding PriceText}" FontSize="{StaticResource FontSizeCallout}" FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light={StaticResource Primary700}, Dark={StaticResource Primary400}}" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>
                                    <!-- A small check in the tile's top-right corner when selected, like the SPA's Kassa
                                         (on top of the tile, 8 from its edge; the tile has a 4 margin) -->
                                    <Border WidthRequest="22" HeightRequest="22" StrokeShape="RoundRectangle 11" StrokeThickness="0"
                                            HorizontalOptions="End" VerticalOptions="Start" Margin="0,12,12,0" InputTransparent="True"
                                            BackgroundColor="{StaticResource Primary500}" IsVisible="{Binding IsSelected}">
                                        <controls:IconView Icon="{x:Static loc:Icons.Check}" Size="13" Color="White" />
                                    </Border>
                                    </Grid>
                                </controls:Pressable>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>

                    <Label Text="{x:Static loc:Texts.People}" Style="{StaticResource SectionHeader}" SemanticProperties.HeadingLevel="Level2" />
                    <SearchBar Text="{Binding UserQuery}" Placeholder="{x:Static loc:Texts.SearchPeople}" IsVisible="{Binding ShowUserSearch}" />
                    <VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding VisibleUsers}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:UserItemViewModel">
                                <controls:Pressable SemanticProperties.Description="{Binding Description}"
                                                    Command="{Binding ToggleUserCommand, Source={RelativeSource AncestorType={x:Type vm:PosViewModel}}, x:DataType=vm:PosViewModel}"
                                                    CommandParameter="{Binding .}">
                                    <Border Style="{StaticResource Tile}">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Stroke" Value="{StaticResource Primary500}" />
                                                <Setter Property="StrokeThickness" Value="2" />
                                                <Setter Property="Padding" Value="11" />
                                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary50}, Dark={StaticResource Primary950}}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
                                            <Grid WidthRequest="40" HeightRequest="40">
                                                <Border Style="{StaticResource Avatar}">
                                                    <Label Text="{Binding Initials}" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold" FontAutoScalingEnabled="False" />
                                                </Border>
                                                <Border Style="{StaticResource Avatar}" IsVisible="{Binding HasPicture}">
                                                    <controls:FadeImage Source="{Binding PictureUrl}" Aspect="AspectFill" />
                                                </Border>
                                            </Grid>
                                            <Label Grid.Column="1" Text="{Binding Title}" VerticalOptions="Center" LineBreakMode="TailTruncation">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsSelf}" Value="True">
                                                        <Setter Property="FontAttributes" Value="Bold" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                            <!-- Your saldo (your own row only) -->
                                            <Label Grid.Column="2" Text="{Binding SaldoText}" IsVisible="{Binding HasSaldo}" FontAttributes="Bold"
                                                   VerticalOptions="Center"
                                                   TextColor="{AppThemeBinding Light={StaticResource Primary700}, Dark={StaticResource Primary400}}">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsSaldoNegative}" Value="True">
                                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                            <!-- Opacity, not IsVisible: the check never changes the layout -->
                                            <controls:IconView Grid.Column="3" Icon="{x:Static loc:Icons.CircleCheck}" Size="22" Opacity="0"
                                                               Color="{AppThemeBinding Light={StaticResource Primary700}, Dark={StaticResource Primary400}}">
                                                <controls:IconView.Triggers>
                                                    <DataTrigger TargetType="controls:IconView" Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Opacity" Value="1" />
                                                    </DataTrigger>
                                                </controls:IconView.Triggers>
                                            </controls:IconView>
                                        </Grid>
                                    </Border>
                                </controls:Pressable>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" HorizontalOptions="Center" VerticalOptions="Center" />
        <!-- First load: placeholders in the page's shape; a failed first load: error with retry -->
        <controls:SkeletonView Kind="Tiles" IsVisible="{Binding ShowSkeleton}" />
        <controls:ErrorStateView IsVisible="{Binding HasLoadError}" RetryCommand="{Binding LoadCommand}" />

        <!-- Pay panel -->
        <Border Grid.Row="1" Style="{StaticResource BottomPanel}">
            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="10">
                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                    <Label Text="{x:Static loc:Texts.Amount}" VerticalOptions="Center" />
                    <Button Text="−" Command="{Binding DecreaseAmountCommand}" Style="{StaticResource StepperButton}"
                            SemanticProperties.Description="Minder">
                        <Button.Behaviors>
                            <controls:PressScaleBehavior PressedScale="0.88" />
                        </Button.Behaviors>
                    </Button>
                    <Label Text="{Binding Amount}" FontAttributes="Bold" FontSize="{StaticResource FontSizeTitle}" VerticalOptions="Center"
                           MinimumWidthRequest="28" HorizontalTextAlignment="Center" />
                    <Button Text="+" Command="{Binding IncreaseAmountCommand}" Style="{StaticResource StepperButton}"
                            SemanticProperties.Description="Meer">
                        <Button.Behaviors>
                            <controls:PressScaleBehavior PressedScale="0.88" />
                        </Button.Behaviors>
                    </Button>
                </HorizontalStackLayout>
                <!-- Always in the layout, so the bar keeps its height; the code-behind fades it in and out
                     (Opacity, input and screen readers follow CanSplit). -->
                <HorizontalStackLayout x:Name="SplitPanel" Grid.Column="1" Spacing="6" VerticalOptions="Center" Opacity="0"
                                       InputTransparent="True" AutomationProperties.IsInAccessibleTree="False">
                    <Label Text="{x:Static loc:Texts.Split}" VerticalOptions="Center" />
                    <Switch IsToggled="{Binding Split}" IsEnabled="{Binding CanSplit}" OnColor="{StaticResource Primary500}"
                            SemanticProperties.Description="{x:Static loc:Texts.Split}" />
                </HorizontalStackLayout>

                <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding SummaryText}" FontAttributes="Bold"
                       SemanticProperties.Description="{Binding SummaryText}" />

                <Button Grid.Row="2" Grid.ColumnSpan="2" Text="{x:Static loc:Texts.Order}"
                        Command="{Binding SubmitCommand}" IsEnabled="{Binding CanSubmit}" Style="{StaticResource PrimaryButton}">
                    <Button.Behaviors>
                        <controls:PressScaleBehavior PressedScale="0.97" />
                    </Button.Behaviors>
                </Button>
                <ActivityIndicator Grid.Row="2" Grid.ColumnSpan="2" IsRunning="{Binding IsSubmitting}" IsVisible="{Binding IsSubmitting}"
                                   Color="White" HorizontalOptions="End" Margin="0,0,16,0" />

                <!-- Confirmation of the order just placed: covers the panel for a few seconds (tap to close). Faded in
                     and out from code; always in the layout, so the panel keeps its height. -->
                <Grid x:Name="OrderPlacedPanel" Grid.RowSpan="3" Grid.ColumnSpan="2" Opacity="0" InputTransparent="True"
                      AutomationProperties.IsInAccessibleTree="False"
                      BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding DismissOrderPlacedCommand}" />
                    </Grid.GestureRecognizers>
                    <HorizontalStackLayout Spacing="14" HorizontalOptions="Center" VerticalOptions="Center">
                        <Border x:Name="OrderPlacedBadge" WidthRequest="52" HeightRequest="52" StrokeThickness="0" StrokeShape="RoundRectangle 26"
                                VerticalOptions="Center"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Primary100}, Dark={StaticResource Primary900}}">
                            <controls:IconView Icon="{x:Static loc:Icons.Check}" Size="28"
                                               Color="{AppThemeBinding Light={StaticResource Primary700}, Dark={StaticResource Primary300}}" />
                        </Border>
                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                            <Label Text="{x:Static loc:Texts.OrderPlaced}" FontSize="{StaticResource FontSizeTitle}" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource HeadingLight}, Dark={StaticResource HeadingDark}}" />
                            <Label Text="{Binding OrderPlacedDetail}" LineBreakMode="TailTruncation" MaximumWidthRequest="260" />
                            <Label Text="{Binding OrderPlacedSaldo}" Style="{StaticResource Muted}"
                                   IsVisible="{Binding OrderPlacedSaldo, Converter={StaticResource NotNull}}" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
