<?xml version="1.0" encoding="UTF-8" ?>
<!-- Matches the SPA: PrimeNG Aura with emerald as primary (Frontend/src/app/app.config.ts). Aura uses slate
     surfaces in light mode and zinc surfaces in dark mode. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Color x:Key="Primary50">#ECFDF5</Color>
    <Color x:Key="Primary100">#D1FAE5</Color>
    <Color x:Key="Primary200">#A7F3D0</Color>
    <Color x:Key="Primary300">#6EE7B7</Color>
    <Color x:Key="Primary400">#34D399</Color>
    <Color x:Key="Primary500">#10B981</Color>
    <Color x:Key="Primary600">#059669</Color>
    <Color x:Key="Primary700">#047857</Color>
    <Color x:Key="Primary800">#065F46</Color>
    <Color x:Key="Primary900">#064E3B</Color>
    <Color x:Key="Primary950">#022C22</Color>

    <!-- The logo's background: the splash screen, the app icon and the welcome page. -->
    <Color x:Key="Brand">#212529</Color>
    <Color x:Key="BrandMuted">#ADB5BD</Color>

    <!-- Page = the SPA's bg-surface-50 / dark:bg-surface-950, Surface = its cards. -->
    <Color x:Key="PageLight">#F8FAFC</Color>
    <Color x:Key="PageDark">#09090B</Color>
    <Color x:Key="SurfaceLight">#FFFFFF</Color>
    <Color x:Key="SurfaceDark">#18181B</Color>
    <!-- Pressed rows and segmented-control tracks (surface-100 / surface-800). -->
    <Color x:Key="SunkenLight">#F1F5F9</Color>
    <Color x:Key="SunkenDark">#27272A</Color>
    <Color x:Key="BorderLight">#E2E8F0</Color>
    <Color x:Key="BorderDark">#3F3F46</Color>
    <Color x:Key="TextLight">#334155</Color>
    <Color x:Key="TextDark">#F4F4F5</Color>
    <Color x:Key="HeadingLight">#0F172A</Color>
    <Color x:Key="HeadingDark">#FFFFFF</Color>
    <Color x:Key="MutedLight">#64748B</Color>
    <Color x:Key="MutedDark">#A1A1AA</Color>
    <Color x:Key="Danger">#DC2626</Color>
    <Color x:Key="DangerDark">#F87171</Color>
    <Color x:Key="NoticeLight">#FEF3C7</Color>
    <Color x:Key="NoticeDark">#422006</Color>
</ResourceDictionary>
