<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:SSSKL.Mobile.Controls"
             xmlns:vm="clr-namespace:SSSKL.Mobile.Core.ViewModels;assembly=SSSKL.Mobile.Core"
             xmlns:loc="clr-namespace:SSSKL.Mobile.Core.Localization;assembly=SSSKL.Mobile.Core"
             x:Class="SSSKL.Mobile.Views.StatsPage"
             x:DataType="vm:StatsViewModel"
             Title="{Binding Title}">
    <Grid>
        <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding LoadCommand}">
            <ScrollView>
                <VerticalStackLayout Padding="16,8,16,32" Spacing="16">
                    <!-- Intro and recalculation -->
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{Binding Subtitle}" Style="{StaticResource Muted}" />
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" IsVisible="{Binding HasStats}">
                            <Grid>
                                <Button Text="{x:Static loc:Texts.RecalculateStats}" Command="{Binding RecalculateCommand}"
                                        Style="{StaticResource SecondaryButton}">
                                    <Button.Behaviors>
                                        <controls:PressScaleBehavior />
                                    </Button.Behaviors>
                                </Button>
                                <ActivityIndicator IsRunning="{Binding IsRecalculating}" IsVisible="{Binding IsRecalculating}"
                                                   HeightRequest="18" WidthRequest="18" HorizontalOptions="End" Margin="0,0,8,0" />
                            </Grid>
                            <Label Grid.Column="1" Text="{Binding LastRecalculatedText}" Style="{StaticResource Muted}" FontSize="13"
                                   VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>

                    <!-- Highlights: two by two -->
                    <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding Highlights}" Margin="-4,0">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:StatTile">
                                <Border Style="{StaticResource Card}" FlexLayout.Basis="50%" Margin="4" Padding="14,12">
                                    <VerticalStackLayout Spacing="6">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Text="{Binding Label}" Style="{StaticResource Muted}" FontSize="13" VerticalOptions="Center" />
                                            <controls:IconView Grid.Column="1" Icon="{Binding Icon}" Size="18"
                                                               Color="{AppThemeBinding Light={StaticResource Primary600}, Dark={StaticResource Primary400}}" />
                                        </Grid>
                                        <Label Text="{Binding Value}" FontSize="22" FontAttributes="Bold" LineBreakMode="TailTruncation"
                                               TextColor="{AppThemeBinding Light={StaticResource HeadingLight}, Dark={StaticResource HeadingDark}}" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>

                    <!-- Sections of figures -->
                    <VerticalStackLayout Spacing="16" BindableLayout.ItemsSource="{Binding Sections}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:StatSection">
                                <VerticalStackLayout Spacing="6">
                                    <HorizontalStackLayout Spacing="8">
                                        <controls:IconView Icon="{Binding Icon}" Size="18"
                                                           Color="{AppThemeBinding Light={StaticResource Primary600}, Dark={StaticResource Primary400}}" />
                                        <Label Text="{Binding Title}" Style="{StaticResource SectionHeader}" Margin="0" VerticalOptions="Center"
                                               SemanticProperties.HeadingLevel="Level2" />
                                    </HorizontalStackLayout>
                                    <Border Style="{StaticResource Group}">
                                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Lines}">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="vm:StatLine">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="14,11"
                                                          SemanticProperties.Description="{Binding AccessibleText}">
                                                        <Label Text="{Binding Label}" VerticalOptions="Center"
                                                               TextColor="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
                                                        <Label Grid.Column="1" Text="{Binding Value}" FontAttributes="Bold" HorizontalTextAlignment="End"
                                                               VerticalOptions="Center" MaximumWidthRequest="200"
                                                               TextColor="{AppThemeBinding Light={StaticResource HeadingLight}, Dark={StaticResource HeadingDark}}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>
                                    </Border>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <!-- Achievements -->
                    <VerticalStackLayout Spacing="8" IsVisible="{Binding HasStats}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <controls:IconView Icon="{x:Static loc:Icons.Trophy}" Size="18"
                                               Color="{AppThemeBinding Light={StaticResource Primary600}, Dark={StaticResource Primary400}}" />
                            <Label Grid.Column="1" Text="{x:Static loc:Texts.Achievements}" Style="{StaticResource SectionHeader}" Margin="0"
                                   VerticalOptions="Center" SemanticProperties.HeadingLevel="Level2" />
                            <Button Grid.Column="2" Text="{x:Static loc:Texts.ViewAll}" Command="{Binding OpenAllAchievementsCommand}"
                                    Style="{StaticResource SecondaryButton}" />
                        </Grid>
                        <Label Text="{x:Static loc:Texts.NoAchievements}" IsVisible="{Binding HasNoAchievements}" Style="{StaticResource Muted}" />
                        <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding Achievements}" Margin="-4,0">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:AchievementChip">
                                    <controls:Pressable Margin="4" SemanticProperties.Description="{Binding Name}"
                                                        Command="{Binding OpenAchievementCommand, Source={RelativeSource AncestorType={x:Type vm:StatsViewModel}}, x:DataType=vm:StatsViewModel}"
                                                        CommandParameter="{Binding .}">
                                        <Border Style="{StaticResource Card}" Padding="8,6">
                                            <HorizontalStackLayout Spacing="8">
                                                <Image Source="{Binding ImageUrl}" WidthRequest="32" HeightRequest="32" Aspect="AspectFit"
                                                       IsVisible="{Binding HasImage}" />
                                                <Label Text="{Binding Name}" FontSize="13" VerticalOptions="Center" MaximumWidthRequest="180"
                                                       LineBreakMode="TailTruncation"
                                                       TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
                                            </HorizontalStackLayout>
                                        </Border>
                                    </controls:Pressable>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
        <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" HorizontalOptions="Center" VerticalOptions="Center" />
        <!-- First load: placeholders in the page's shape; a failed first load: error with retry -->
        <controls:SkeletonView Kind="Profile" IsVisible="{Binding ShowSkeleton}" />
        <controls:ErrorStateView IsVisible="{Binding HasLoadError}" RetryCommand="{Binding LoadCommand}" />
    </Grid>
</ContentPage>
