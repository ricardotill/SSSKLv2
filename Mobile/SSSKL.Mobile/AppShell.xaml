<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:loc="clr-namespace:SSSKL.Mobile.Core.Localization;assembly=SSSKL.Mobile.Core"
       x:Class="SSSKL.Mobile.AppShell"
       Shell.FlyoutBehavior="Disabled">
    <!-- Icons: outline; the selected tab gets the filled variant (tab_*_selected, set from code) -->
    <TabBar>
        <Tab x:Name="PosTab" Title="{x:Static loc:Texts.TabPos}" Route="pos" Icon="tab_pos.png">
            <ShellContent x:Name="PosContent" />
        </Tab>
        <!-- BadgeText (the unread count) is set from code; null hides the bubble -->
        <Tab x:Name="NotificationsTab" Title="{x:Static loc:Texts.TabNotifications}" Route="notifications" Icon="tab_notifications.png"
             BadgeColor="{StaticResource Danger}" BadgeTextColor="White">
            <ShellContent x:Name="NotificationsContent" />
        </Tab>
        <Tab x:Name="ProfileTab" Title="{x:Static loc:Texts.TabProfile}" Route="profile" Icon="tab_profile.png">
            <ShellContent x:Name="ProfileContent" />
        </Tab>
        <Tab x:Name="MoreTab" Title="{x:Static loc:Texts.TabMore}" Route="more" Icon="tab_more.png">
            <ShellContent x:Name="MoreContent" />
        </Tab>
    </TabBar>
</Shell>
