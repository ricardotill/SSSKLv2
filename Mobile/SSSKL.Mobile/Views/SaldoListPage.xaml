<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:SSSKL.Mobile.Controls"
             xmlns:vm="clr-namespace:SSSKL.Mobile.Core.ViewModels;assembly=SSSKL.Mobile.Core"
             xmlns:loc="clr-namespace:SSSKL.Mobile.Core.Localization;assembly=SSSKL.Mobile.Core"
             x:Class="SSSKL.Mobile.Views.SaldoListPage"
             x:DataType="vm:SaldoListViewModel"
             Title="{x:Static loc:Texts.SaldoList}">
    <Grid RowDefinitions="Auto,*">
        <SearchBar Text="{Binding Query}" Placeholder="{x:Static loc:Texts.SearchMembers}" Margin="8,4,8,0"
                   SemanticProperties.Description="{x:Static loc:Texts.SearchMembers}" />
        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsRefreshing}" Command="{Binding LoadCommand}">
            <CollectionView ItemsSource="{Binding Members}" SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
                </CollectionView.ItemsLayout>
                <CollectionView.Header>
                    <BoxView HeightRequest="8" Color="Transparent" />
                </CollectionView.Header>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:MemberRow">
                        <controls:MemberRowView Command="{Binding OpenCommand, Source={RelativeSource AncestorType={x:Type vm:SaldoListViewModel}}, x:DataType=vm:SaldoListViewModel}" />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <Label Text="{x:Static loc:Texts.NoUsers}" IsVisible="{Binding IsEmpty}" Style="{StaticResource Muted}"
                           HorizontalTextAlignment="Center" Margin="32,64" />
                </CollectionView.EmptyView>
                <CollectionView.Footer>
                    <BoxView HeightRequest="16" Color="Transparent" />
                </CollectionView.Footer>
            </CollectionView>
        </RefreshView>
        <ActivityIndicator Grid.Row="1" IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" HorizontalOptions="Center" VerticalOptions="Center" />
        <!-- First load: placeholders in the page's shape; a failed first load: error with retry -->
        <controls:SkeletonView Grid.Row="1" Kind="Rows" IsVisible="{Binding ShowSkeleton}" />
        <controls:ErrorStateView Grid.Row="1" IsVisible="{Binding HasLoadError}" RetryCommand="{Binding LoadCommand}" />
    </Grid>
</ContentPage>
