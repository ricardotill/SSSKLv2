# Caddy in the frontend image (Frontend/Dockerfile): serves the SPA and passes the API on, on one origin.
# HTTPS is done in front of it (a Cloudflare Tunnel or your own proxy), so Caddy only speaks HTTP.
{
	admin off
	auto_https off
	# The proxy in front (cloudflared, a load balancer) sends the visitor's address and https in
	# X-Forwarded-For/-Proto; the API reads them. Only private networks can reach this container.
	servers {
		trusted_proxies static private_ranges
	}
}

:8080 {
	encode zstd gzip

	# Same headers as Azure Static Web Apps (public/staticwebapp.config.json)
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "frame-ancestors 'none'"
		-Server
	}

	# The API and the SignalR hub (WebSockets pass through reverse_proxy as they are)
	@api path /api/* /hubs/*
	handle @api {
		reverse_proxy {$API_UPSTREAM}
	}

	handle {
		root * /srv
		# The service worker must always see the newest index.html and ngsw.json, or updates never install;
		# the hashed bundles may be cached forever.
		@nocache path / /index.html /ngsw.json /ngsw-worker.js /safety-worker.js /manifest.webmanifest
		header @nocache Cache-Control "no-cache"
		@hashed path_regexp -[0-9A-Z]{8}\.(js|css)$
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
