    </Project>
    <Project Path="Backend/SSSKL.Contracts/SSSKL.Contracts.csproj">
      <BuildType Solution="DebugProduction|*" Project="Debug" />
    </Project>
    <Project Path="Backend/SSSKL.Application/SSSKL.Application.csproj">
      <BuildType Solution="DebugProduction|*" Project="Debug" />
    </Project>
    <Project Path="Backend/SSSKL.Infrastructure/SSSKL.Infrastructure.csproj">
      <BuildType Solution="DebugProduction|*" Project="Debug" />
    </Project>
    <Project Path="Backend/SSSKL.Web/SSSKL.Web.csproj">
      <BuildType Solution="DebugProduction|*" Project="Debug" />
    </Project>
  </Folder>
  <Folder Name="/hosting/">
    <Project Path="Backend/SSSKL.AppHost/SSSKL.AppHost.csproj">
      <BuildType Solution="DebugProduction|*" Project="Debug" />
    </Project>
    <Project Path="Backend/SSSKL.ServiceDefaults/SSSKL.ServiceDefaults.csproj">
      <BuildType Solution="DebugProduction|*" Project="Debug" />
