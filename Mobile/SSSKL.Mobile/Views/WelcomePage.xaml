<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:SSSKL.Mobile.Core.Localization;assembly=SSSKL.Mobile.Core"
             x:Class="SSSKL.Mobile.Views.WelcomePage"
             Title="{x:Static loc:Texts.AppName}"
             Shell.NavBarIsVisible="False">
    <ScrollView>
        <Grid Padding="16" MinimumHeightRequest="480">
            <Border Style="{StaticResource Card}"
                    Padding="24,32"
                    MaximumWidthRequest="480"
                    VerticalOptions="Center">
                <VerticalStackLayout Spacing="24">
                    <!-- Logo: 144x144, rounded, with a shadow (like the SPA's about page) -->
                    <Border WidthRequest="144"
                            HeightRequest="144"
                            HorizontalOptions="Center"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12"
                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
                        <Border.Shadow>
                            <Shadow Brush="Black" Opacity="0.25" Radius="16" Offset="0,6" />
                        </Border.Shadow>
                        <Image Source="logo.png"
                               Aspect="AspectFill"
                               SemanticProperties.Description="{x:Static loc:Texts.Logo}" />
                    </Border>

                    <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                        <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                            <Label Text="{x:Static loc:Texts.AppName}"
                                   Style="{StaticResource Headline}"
                                   FontSize="30"
                                   SemanticProperties.HeadingLevel="Level1"
                                   VerticalOptions="Center" />
                            <Label x:Name="VersionLabel"
                                   Style="{StaticResource Muted}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Label Style="{StaticResource Muted}"
                               FontSize="15"
                               HorizontalTextAlignment="Center"
                               SemanticProperties.Hint="{x:Static loc:Texts.OpenAuthorWebsite}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnAuthorTapped" />
                            </Label.GestureRecognizers>
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{x:Static loc:Texts.MadeWithLoveBy}" />
                                    <Span Text=" " />
                                    <Span Text="{x:Static loc:Texts.Author}"
                                          FontAttributes="Bold"
                                          TextColor="{AppThemeBinding Light={StaticResource Primary700}, Dark={StaticResource Primary400}}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </VerticalStackLayout>

                    <Button x:Name="LoginButton"
                            Text="{x:Static loc:Texts.Login}"
                            Style="{StaticResource PrimaryButton}"
                            Clicked="OnLoginClicked" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>
</ContentPage>
