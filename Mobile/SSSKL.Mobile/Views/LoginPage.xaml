<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:SSSKL.Mobile.Controls"
             xmlns:loc="clr-namespace:SSSKL.Mobile.Core.Localization;assembly=SSSKL.Mobile.Core"
             x:Class="SSSKL.Mobile.Views.LoginPage"
             Title="{x:Static loc:Texts.Login}"
             Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="Auto,*">
        <!-- Sheet header: title and close button -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="16,8"
              BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
            <Label Text="{x:Static loc:Texts.Login}" Style="{StaticResource Title}" VerticalOptions="Center"
                   SemanticProperties.HeadingLevel="Level1" />
            <Button Grid.Column="1" Text="{x:Static loc:Texts.Close}" Style="{StaticResource SecondaryButton}"
                    VerticalOptions="Center" Clicked="OnCloseClicked" />
        </Grid>
        <BoxView Grid.Row="0" HeightRequest="1" VerticalOptions="End"
                 Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />

        <Grid Grid.Row="1">
            <controls:SssklWebView x:Name="WebView"
                                   Navigating="OnNavigating"
                                   Navigated="OnNavigated" />
            <ActivityIndicator x:Name="Loading" IsRunning="True" HorizontalOptions="Center" VerticalOptions="Center" />
            <VerticalStackLayout x:Name="ErrorPanel" IsVisible="False" Spacing="12" Padding="24"
                                 HorizontalOptions="Center" VerticalOptions="Center">
                <Label Text="{x:Static loc:Texts.LoadFailed}" HorizontalTextAlignment="Center" />
                <Button Text="{x:Static loc:Texts.Retry}" Clicked="OnRetry" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
