<Solution>
  <!-- Backend only. The mobile app (still in development) has its own solution, Mobile/SSSKL.Mobile.slnx,
       so `dotnet build/test SSSKL.slnx` and the backend CI and deploys don't build or test it. -->
  <Configurations>
    <BuildType Name="Debug" />
    <BuildType Name="Release" />
    <BuildType Name="DebugProduction" />
  </Configurations>
  <Folder Name="/Bestanden/">
    <File Path=".dockerignore" />
    <File Path=".env.example" />
    <File Path=".github/dependabot.yml" />
    <File Path=".github/workflows/azure-static-web-apps-ambitious-desert-07f83a203.yml" />
    <File Path=".github/workflows/dotnet.yml" />
    <File Path=".github/workflows/frontend-ci.yml" />
    <File Path=".github/workflows/master_sssklv2-app.yml" />
    <File Path=".github/workflows/version.yml" />
    <File Path=".gitignore" />
    <File Path="Backend/Dockerfile" />
    <File Path="CLAUDE.md" />
    <File Path="Directory.Build.props" />
    <File Path="Directory.Packages.props" />
    <File Path="docker-compose.external.yml" />
    <File Path="docker-compose.yml" />
    <File Path="LICENSE.txt" />
    <File Path="README.md" />
  </Folder>
  <Folder Name="/Bestanden/docs/">
    <File Path="docs/APPLICATION_INSIGHTS_QUERIES.md" />
    <File Path="docs/CHANGELOG.md" />
    <File Path="docs/docker.md" />
    <File Path="docs/MEDIATR_LICENSE_SETUP.md" />
    <File Path="docs/SIXLABORS_LICENSE_SETUP.md" />
  </Folder>
  <Folder Name="/src/">
    <Project Path="Backend/SSSKL.Domain/SSSKL.Domain.csproj">
