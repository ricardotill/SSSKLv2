<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:SSSKL.Mobile.Controls"
             xmlns:vm="clr-namespace:SSSKL.Mobile.Core.ViewModels;assembly=SSSKL.Mobile.Core"
             xmlns:models="clr-namespace:SSSKL.Mobile.Core.Models;assembly=SSSKL.Mobile.Core"
             xmlns:loc="clr-namespace:SSSKL.Mobile.Core.Localization;assembly=SSSKL.Mobile.Core"
             x:Class="SSSKL.Mobile.Views.EventDetailPage"
             x:DataType="vm:EventDetailViewModel"
             Title="{Binding Title}">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="{x:Static loc:Texts.Share}" IconImageSource="ti_share.png" Command="{Binding ShareCommand}"
                     SemanticProperties.Description="{x:Static loc:Texts.Share}" />
    </ContentPage.ToolbarItems>

    <Grid>
        <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding LoadCommand}">
            <ScrollView>
                <VerticalStackLayout Padding="16,8,16,32" Spacing="16">
                    <Label Text="{x:Static loc:Texts.EventNotFound}" IsVisible="{Binding IsNotFound}" Style="{StaticResource Muted}"
                           HorizontalTextAlignment="Center" Margin="16,48" />

                    <VerticalStackLayout Spacing="16" IsVisible="{Binding IsFound}">
                        <!-- The event -->
                        <Border Style="{StaticResource Card}" Padding="0">
                            <VerticalStackLayout>
                                <Image Source="{Binding ImageUrl}" Aspect="AspectFill" HeightRequest="200" IsVisible="{Binding HasImage}" />
                                <VerticalStackLayout Padding="16" Spacing="14">
                                    <Label Text="{Binding Title}" Style="{StaticResource Headline}" SemanticProperties.HeadingLevel="Level1" />
                                    <Border IsVisible="{Binding IsPast}" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="9,3"
                                            HorizontalOptions="Start"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource SunkenLight}, Dark={StaticResource SunkenDark}}">
                                        <Label Text="{x:Static loc:Texts.Past}" FontSize="12" FontAttributes="Bold" Style="{StaticResource Muted}" />
                                    </Border>

                                    <!-- When -->
                                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                                        <controls:IconView Icon="{x:Static loc:Icons.Calendar}" Size="18" VerticalOptions="Start" Margin="0,2,0,0"
                                                           Color="{AppThemeBinding Light={StaticResource Primary600}, Dark={StaticResource Primary400}}" />
                                        <VerticalStackLayout Grid.Column="1">
                                            <Label Text="{x:Static loc:Texts.Starts}" Style="{StaticResource FieldLabel}" />
                                            <Label Text="{Binding StartText}"
                                                   TextColor="{AppThemeBinding Light={StaticResource HeadingLight}, Dark={StaticResource HeadingDark}}" />
                                        </VerticalStackLayout>
                                        <controls:IconView Grid.Row="1" Icon="{x:Static loc:Icons.Calendar}" Size="18" VerticalOptions="Start" Margin="0,2,0,0"
                                                           Color="{AppThemeBinding Light={StaticResource Primary600}, Dark={StaticResource Primary400}}" />
                                        <VerticalStackLayout Grid.Row="1" Grid.Column="1">
                                            <Label Text="{x:Static loc:Texts.Ends}" Style="{StaticResource FieldLabel}" />
                                            <Label Text="{Binding EndText}"
                                                   TextColor="{AppThemeBinding Light={StaticResource HeadingLight}, Dark={StaticResource HeadingDark}}" />
                                        </VerticalStackLayout>
                                    </Grid>

                                    <!-- Where -->
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" IsVisible="{Binding HasLocation}">
                                        <controls:IconView Icon="{x:Static loc:Icons.MapPin}" Size="18" VerticalOptions="Start" Margin="0,2,0,0"
                                                           Color="{AppThemeBinding Light={StaticResource Primary600}, Dark={StaticResource Primary400}}" />
                                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                                            <Label Text="{x:Static loc:Texts.Location}" Style="{StaticResource FieldLabel}" />
                                            <Label Text="{Binding LocationName}"
                                                   TextColor="{AppThemeBinding Light={StaticResource HeadingLight}, Dark={StaticResource HeadingDark}}" />
                                            <Button Text="{x:Static loc:Texts.OpenInMaps}" Command="{Binding OpenMapsCommand}" IsVisible="{Binding CanOpenMaps}"
                                                    Style="{StaticResource SecondaryButton}" HorizontalOptions="Start" />
                                        </VerticalStackLayout>
                                    </Grid>

                                    <!-- Who may come -->
                                    <Label IsVisible="{Binding HasRequiredRoles}" Style="{StaticResource Muted}" FontSize="13">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{x:Static loc:Texts.AllowedRoles}" FontAttributes="Bold" />
                                                <Span Text=": " />
                                                <Span Text="{Binding RequiredRolesText}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>

                                    <BoxView HeightRequest="1" IsVisible="{Binding HasDescription}"
                                             Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
                                    <Label Text="{Binding DescriptionHtml}" TextType="Html" IsVisible="{Binding HasDescription}" FontSize="15"
                                           TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Ben je erbij? -->
                        <Border Style="{StaticResource Card}" Padding="16"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Primary50}, Dark={StaticResource Primary950}}"
                                Stroke="{AppThemeBinding Light={StaticResource Primary200}, Dark={StaticResource Primary900}}">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="{x:Static loc:Texts.AreYouComing}" FontSize="18" FontAttributes="Bold" SemanticProperties.HeadingLevel="Level2"
                                       TextColor="{AppThemeBinding Light={StaticResource HeadingLight}, Dark={StaticResource HeadingDark}}" />
                                <Label Text="{x:Static loc:Texts.AreYouComingHint}" Style="{StaticResource Muted}" />
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10" IsVisible="{Binding CanRsvp}">
                                    <Button Text="{x:Static loc:Texts.Accept}" Command="{Binding RsvpCommand}"
                                            CommandParameter="{x:Static models:EventResponse.Accepted}" Style="{StaticResource LinkButton}">
                                        <Button.Triggers>
                                            <DataTrigger TargetType="Button" Binding="{Binding IsAccepted}" Value="True">
                                                <Setter Property="BackgroundColor" Value="#166534" />
                                                <Setter Property="TextColor" Value="White" />
                                                <Setter Property="BorderColor" Value="#166534" />
                                            </DataTrigger>
                                        </Button.Triggers>
                                        <Button.Behaviors>
                                            <controls:PressScaleBehavior />
                                        </Button.Behaviors>
                                    </Button>
                                    <Button Grid.Column="1" Text="{x:Static loc:Texts.Decline}" Command="{Binding RsvpCommand}"
                                            CommandParameter="{x:Static models:EventResponse.Declined}" Style="{StaticResource LinkButton}">
                                        <Button.Triggers>
                                            <DataTrigger TargetType="Button" Binding="{Binding IsDeclined}" Value="True">
                                                <Setter Property="BackgroundColor" Value="#991B1B" />
                                                <Setter Property="TextColor" Value="White" />
                                                <Setter Property="BorderColor" Value="#991B1B" />
                                            </DataTrigger>
                                        </Button.Triggers>
                                        <Button.Behaviors>
                                            <controls:PressScaleBehavior />
                                        </Button.Behaviors>
                                    </Button>
                                </Grid>
                                <Label Text="{x:Static loc:Texts.RsvpNoRole}" IsVisible="{Binding ShowsRsvpNoRole}" Style="{StaticResource Muted}"
                                       FontAttributes="Italic" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Attendees -->
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding AttendeesText}" Style="{StaticResource SectionHeader}" Margin="0" SemanticProperties.HeadingLevel="Level2" />
                            <Label Text="{x:Static loc:Texts.NoAttendees}" IsVisible="{Binding HasNoAttendees}" Style="{StaticResource Muted}" FontAttributes="Italic" />
                            <VerticalStackLayout Spacing="8" Margin="-16,0" BindableLayout.ItemsSource="{Binding Accepted}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MemberRow">
                                        <controls:MemberRowView Command="{Binding OpenMemberCommand, Source={RelativeSource AncestorType={x:Type vm:EventDetailViewModel}}, x:DataType=vm:EventDetailViewModel}" />
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="8" IsVisible="{Binding HasDeclined}">
                            <Label Text="{Binding DeclinedText}" Style="{StaticResource SectionHeader}" Margin="0" SemanticProperties.HeadingLevel="Level2" />
                            <VerticalStackLayout Spacing="8" Margin="-16,0" BindableLayout.ItemsSource="{Binding Declined}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MemberRow">
                                        <controls:MemberRowView Command="{Binding OpenMemberCommand, Source={RelativeSource AncestorType={x:Type vm:EventDetailViewModel}}, x:DataType=vm:EventDetailViewModel}" />
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>

                        <!-- Creator and admins -->
                        <Border Style="{StaticResource Group}" IsVisible="{Binding CanEdit}">
                            <VerticalStackLayout>
                                <controls:MenuRow IsFirst="True" Icon="{x:Static loc:Icons.Pencil}" Title="{x:Static loc:Texts.Edit}"
                                                  Command="{Binding EditCommand}" />
                                <controls:MenuRow Icon="{x:Static loc:Icons.Photo}" Title="{x:Static loc:Texts.ChangeImage}"
                                                  Command="{Binding ChangeImageCommand}" />
                                <controls:MenuRow Icon="{x:Static loc:Icons.Trash}" Title="{x:Static loc:Texts.DeleteEvent}"
                                                  IsDestructive="True" ShowChevron="False" Command="{Binding DeleteCommand}" />
                            </VerticalStackLayout>
                        </Border>

                        <controls:CommentsView BindingContext="{Binding Comments}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
        <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" HorizontalOptions="Center" VerticalOptions="Center" />
        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="Center" VerticalOptions="Center" />
    </Grid>
</ContentPage>
