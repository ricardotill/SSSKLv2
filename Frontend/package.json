{
  "name": "sssklv2",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "prestart": "node setup-ssl.js",
    "start": "NODE_TLS_REJECT_UNAUTHORIZED=0 node ng-env.js serve --port $PORT",
    "start:mobile": "services__ssskl__http__0=${SSSKL_API_URL:-http://localhost:5251} node ng-env.js serve --port 4300 --ssl=false --host 0.0.0.0",
    "build": "node ng-env.js build",
    "postbuild": "node sentry-sourcemaps.js",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --no-watch",
    "test:update": "UPDATE_SNAPSHOTS=true ng test --no-watch",
    "test:coverage": "ng test --no-watch --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install --with-deps chromium"
  },
  "private": true,
  "packageManager": "npm@11.12.0",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "dependencies": {
    "@angular/animations": "^22.2.3",
    "@angular/cdk": "^22.2.6",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.5",
    "@angular/platform-browser": "^22.2.3",
    "@angular/router": "^22.2.5",
    "@angular/service-worker": "^22.2.5",
    "@googlemaps/js-api-loader": "^2.1.3",
    "@microsoft/signalr": "^10.0.11",
    "@primeng/mcp": "^22.1.4",
    "@primeuix/themes": "^3.1.0",
    "@sentry/angular": "^11.11.0",
    "canvas-confetti": "^1.9.4",
    "primeicons": "^8.0.2",
    "primeng": "^22.1.4",
    "qrcode": "^1.5.4",
    "quill": "^2.0.3",
    "rxjs": "~7.8.0",
    "tailwindcss-primeui": "^0.6.1",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.5",
    "@playwright/test": "^1.65.0",
    "@sentry/cli": "^3.8.2",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/canvas-confetti": "^1.9.0",
    "@types/google.maps": "^3.66.10",
    "@types/node": "26.6.6",
    "@types/qrcode": "^1.5.6",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^31.0.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.12",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
