<?xml version="1.0" encoding="utf-8" ?>
<!-- The comments under an event or quote; BindingContext is a CommentsViewModel. -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:SSSKL.Mobile.Controls"
             xmlns:vm="clr-namespace:SSSKL.Mobile.Core.ViewModels;assembly=SSSKL.Mobile.Core"
             xmlns:loc="clr-namespace:SSSKL.Mobile.Core.Localization;assembly=SSSKL.Mobile.Core"
             x:Class="SSSKL.Mobile.Controls.CommentsView"
             x:DataType="vm:CommentsViewModel">
    <ContentView.Resources>
        <!-- A small pill button: emoji, 👍/❤️ counts, Reageren -->
        <Style x:Key="Chip" TargetType="Button">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="MinimumHeightRequest" Value="32" />
            <Setter Property="MinimumWidthRequest" Value="40" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="BorderWidth" Value="0" />
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SunkenLight}, Dark={StaticResource SunkenDark}}" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
        </Style>
    </ContentView.Resources>

    <VerticalStackLayout Spacing="12">
        <HorizontalStackLayout Spacing="8">
            <controls:IconView Icon="{x:Static loc:Icons.Message}" Size="18"
                               Color="{AppThemeBinding Light={StaticResource Primary600}, Dark={StaticResource Primary400}}" />
            <Label Text="{x:Static loc:Texts.Comments}" Style="{StaticResource SectionHeader}" Margin="0" VerticalOptions="Center"
                   SemanticProperties.HeadingLevel="Level2" />
        </HorizontalStackLayout>

        <!-- New comment (or reply) -->
        <Border Style="{StaticResource Card}" Padding="12">
            <VerticalStackLayout Spacing="8">
                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsReplying}">
                    <Label Text="{Binding ReplyText}" FontSize="13" FontAttributes="Bold" VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Primary700}, Dark={StaticResource Primary400}}" />
                    <Button Grid.Column="1" Text="{x:Static loc:Texts.Cancel}" Command="{Binding CancelReplyCommand}" Style="{StaticResource Chip}" />
                </Grid>
                <Border Style="{StaticResource FieldBox}" Padding="8,2">
                    <Editor Text="{Binding NewText}" Placeholder="{x:Static loc:Texts.CommentPlaceholder}" AutoSize="TextChanges"
                            MinimumHeightRequest="44" FontSize="15" Keyboard="Chat" BackgroundColor="Transparent"
                            TextColor="{AppThemeBinding Light={StaticResource HeadingLight}, Dark={StaticResource HeadingDark}}"
                            PlaceholderColor="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}"
                            SemanticProperties.Description="{x:Static loc:Texts.CommentPlaceholder}" />
                </Border>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <HorizontalStackLayout Spacing="4" BindableLayout.ItemsSource="{Binding QuickReactions}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Button Text="{Binding .}" Style="{StaticResource Chip}" FontSize="16" Padding="6,2"
                                        SemanticProperties.Description="{Binding .}"
                                        Command="{Binding QuickCommand, Source={RelativeSource AncestorType={x:Type vm:CommentsViewModel}}, x:DataType=vm:CommentsViewModel}"
                                        CommandParameter="{Binding .}" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                    <Button Grid.Column="1" Text="{x:Static loc:Texts.Post}" Command="{Binding PostCommand}" Padding="16,6"
                            MinimumHeightRequest="36" CornerRadius="18" FontSize="14">
                        <Button.Behaviors>
                            <controls:PressScaleBehavior />
                        </Button.Behaviors>
                    </Button>
                </Grid>
            </VerticalStackLayout>
        </Border>

        <Label Text="{x:Static loc:Texts.NoComments}" IsVisible="{Binding HasNoComments}" Style="{StaticResource Muted}"
               FontAttributes="Italic" HorizontalTextAlignment="Center" Margin="0,8" />

        <!-- The comments, each with its replies -->
        <VerticalStackLayout Spacing="14" BindableLayout.ItemsSource="{Binding Items}">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="vm:CommentEntry">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" SemanticProperties.Description="{Binding AccessibleText}">
                        <controls:Pressable VerticalOptions="Start" SemanticProperties.Description="{Binding Handle}"
                                            Command="{Binding OpenUserCommand, Source={RelativeSource AncestorType={x:Type vm:CommentsViewModel}}, x:DataType=vm:CommentsViewModel}"
                                            CommandParameter="{Binding .}">
                            <controls:AvatarView Size="36" Initials="{Binding Initials}" PictureUrl="{Binding PictureUrl}" />
                        </controls:Pressable>
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <HorizontalStackLayout Spacing="8">
                                <Label Text="{Binding Handle}" FontAttributes="Bold" FontSize="14"
                                       TextColor="{AppThemeBinding Light={StaticResource HeadingLight}, Dark={StaticResource HeadingDark}}" />
                                <Label Text="{Binding DateText}" Style="{StaticResource Muted}" FontSize="12" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <Label Text="{Binding Content}" FontSize="15"
                                   TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
                            <HorizontalStackLayout Spacing="6">
                                <Button Text="{Binding LikeText, StringFormat='👍 {0}'}" Style="{StaticResource Chip}"
                                        SemanticProperties.Description="👍"
                                        Command="{Binding LikeCommand, Source={RelativeSource AncestorType={x:Type vm:CommentsViewModel}}, x:DataType=vm:CommentsViewModel}"
                                        CommandParameter="{Binding .}">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button" Binding="{Binding HasLiked}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary100}, Dark={StaticResource Primary900}}" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                                <Button Text="{Binding HeartText, StringFormat='❤️ {0}'}" Style="{StaticResource Chip}"
                                        SemanticProperties.Description="❤️"
                                        Command="{Binding HeartCommand, Source={RelativeSource AncestorType={x:Type vm:CommentsViewModel}}, x:DataType=vm:CommentsViewModel}"
                                        CommandParameter="{Binding .}">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button" Binding="{Binding HasHearted}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FEE2E2, Dark=#450A0A}" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                                <Button Text="{x:Static loc:Texts.Reply}" Style="{StaticResource Chip}"
                                        Command="{Binding StartReplyCommand, Source={RelativeSource AncestorType={x:Type vm:CommentsViewModel}}, x:DataType=vm:CommentsViewModel}"
                                        CommandParameter="{Binding .}" />
                                <controls:Pressable IsVisible="{Binding CanDelete}" VerticalOptions="Center"
                                                    SemanticProperties.Description="{x:Static loc:Texts.DeleteComment}"
                                                    Command="{Binding DeleteCommand, Source={RelativeSource AncestorType={x:Type vm:CommentsViewModel}}, x:DataType=vm:CommentsViewModel}"
                                                    CommandParameter="{Binding .}">
                                    <controls:IconView Icon="{x:Static loc:Icons.Trash}" Size="18" Margin="6"
                                                       Color="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
                                </controls:Pressable>
                            </HorizontalStackLayout>

                            <!-- Replies: a flat thread under the comment -->
                            <Grid IsVisible="{Binding HasReplies}" ColumnDefinitions="2,*" ColumnSpacing="10" Margin="0,4,0,0">
                                    <BoxView Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="10" BindableLayout.ItemsSource="{Binding Replies}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="vm:CommentEntry">
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" SemanticProperties.Description="{Binding AccessibleText}">
                                                    <controls:Pressable VerticalOptions="Start" SemanticProperties.Description="{Binding Handle}"
                                                                        Command="{Binding OpenUserCommand, Source={RelativeSource AncestorType={x:Type vm:CommentsViewModel}}, x:DataType=vm:CommentsViewModel}"
                                                                        CommandParameter="{Binding .}">
                                                        <controls:AvatarView Size="26" Initials="{Binding Initials}" PictureUrl="{Binding PictureUrl}" />
                                                    </controls:Pressable>
                                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                                        <Label FontSize="13">
                                                            <Label.FormattedText>
                                                                <FormattedString>
                                                                    <Span Text="{Binding Handle}" FontAttributes="Bold"
                                                                          TextColor="{AppThemeBinding Light={StaticResource HeadingLight}, Dark={StaticResource HeadingDark}}" />
                                                                    <Span Text="{Binding TargetText}"
                                                                          TextColor="{AppThemeBinding Light={StaticResource Primary700}, Dark={StaticResource Primary400}}" />
                                                                    <Span Text="{Binding DateText, StringFormat='  {0}'}"
                                                                          TextColor="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
                                                                </FormattedString>
                                                            </Label.FormattedText>
                                                        </Label>
                                                        <Label Text="{Binding Content}" FontSize="14"
                                                               TextColor="{AppThemeBinding Light={StaticResource TextLight}, Dark={StaticResource TextDark}}" />
                                                        <HorizontalStackLayout Spacing="6">
                                                            <Button Text="{x:Static loc:Texts.Reply}" Style="{StaticResource Chip}" FontSize="12"
                                                                    Command="{Binding StartReplyCommand, Source={RelativeSource AncestorType={x:Type vm:CommentsViewModel}}, x:DataType=vm:CommentsViewModel}"
                                                                    CommandParameter="{Binding .}" />
                                                            <controls:Pressable IsVisible="{Binding CanDelete}" VerticalOptions="Center"
                                                                                SemanticProperties.Description="{x:Static loc:Texts.DeleteComment}"
                                                                                Command="{Binding DeleteCommand, Source={RelativeSource AncestorType={x:Type vm:CommentsViewModel}}, x:DataType=vm:CommentsViewModel}"
                                                                                CommandParameter="{Binding .}">
                                                                <controls:IconView Icon="{x:Static loc:Icons.Trash}" Size="16" Margin="6"
                                                                                   Color="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
                                                            </controls:Pressable>
                                                        </HorizontalStackLayout>
                                                    </VerticalStackLayout>
                                                </Grid>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Grid>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </VerticalStackLayout>
    </VerticalStackLayout>
</ContentView>
