<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:SSSKL.Mobile.Controls"
             xmlns:vm="clr-namespace:SSSKL.Mobile.Core.ViewModels;assembly=SSSKL.Mobile.Core"
             xmlns:models="clr-namespace:SSSKL.Mobile.Core.Models;assembly=SSSKL.Mobile.Core"
             xmlns:loc="clr-namespace:SSSKL.Mobile.Core.Localization;assembly=SSSKL.Mobile.Core"
             x:Class="SSSKL.Mobile.Views.LeaderboardPage"
             x:DataType="vm:LeaderboardViewModel"
             Title="{x:Static loc:Texts.Leaderboard}">
    <Grid>
        <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding LoadCommand}">
            <CollectionView ItemsSource="{Binding Entries}" SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
                </CollectionView.ItemsLayout>

                <CollectionView.Header>
                    <VerticalStackLayout Padding="16,8,16,8" Spacing="12">
                        <!-- Product -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="{x:Static loc:Texts.Product}" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource FieldBox}">
                                <Picker ItemsSource="{Binding Products}" ItemDisplayBinding="{Binding Name, x:DataType=models:Product}"
                                        SelectedItem="{Binding SelectedProduct}" Title="{x:Static loc:Texts.Product}"
                                        BackgroundColor="Transparent" MinimumHeightRequest="44"
                                        TextColor="{AppThemeBinding Light={StaticResource HeadingLight}, Dark={StaticResource HeadingDark}}"
                                        SemanticProperties.Description="{x:Static loc:Texts.Product}" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Period: a segmented control like the colour-mode switch in the settings -->
                        <Border Style="{StaticResource SegmentTrack}">
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="3">
                                <Border Style="{StaticResource Segment}" SemanticProperties.Description="{x:Static loc:Texts.Last12Hours}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SetPeriodCommand}" CommandParameter="{x:Static models:LeaderboardPeriod.Last12Hours}" />
                                    </Border.GestureRecognizers>
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding Is12Hours}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Label Text="{x:Static loc:Texts.Last12Hours}" Style="{StaticResource SegmentText}" HorizontalOptions="Center" />
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource Segment}" SemanticProperties.Description="{x:Static loc:Texts.ThisMonth}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SetPeriodCommand}" CommandParameter="{x:Static models:LeaderboardPeriod.Month}" />
                                    </Border.GestureRecognizers>
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsMonth}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Label Text="{x:Static loc:Texts.ThisMonth}" Style="{StaticResource SegmentText}" HorizontalOptions="Center" />
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource Segment}" SemanticProperties.Description="{x:Static loc:Texts.AllTime}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SetPeriodCommand}" CommandParameter="{x:Static models:LeaderboardPeriod.AllTime}" />
                                    </Border.GestureRecognizers>
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsAllTime}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Label Text="{x:Static loc:Texts.AllTime}" Style="{StaticResource SegmentText}" HorizontalOptions="Center" />
                                </Border>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </CollectionView.Header>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:MemberRow">
                        <controls:MemberRowView Command="{Binding OpenCommand, Source={RelativeSource AncestorType={x:Type vm:LeaderboardViewModel}}, x:DataType=vm:LeaderboardViewModel}" />
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="32,48" Spacing="10" IsVisible="{Binding IsEmpty}">
                        <controls:IconView Icon="{x:Static loc:Icons.Trophy}" Size="48"
                                           Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
                        <Label Text="{x:Static loc:Texts.NoPurchasesPeriod}" Style="{StaticResource Muted}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.Footer>
                    <BoxView HeightRequest="16" Color="Transparent" />
                </CollectionView.Footer>
            </CollectionView>
        </RefreshView>
        <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" HorizontalOptions="Center" VerticalOptions="Center" />
    </Grid>
</ContentPage>
